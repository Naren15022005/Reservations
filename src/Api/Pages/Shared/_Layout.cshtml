@inject FODUN.Reservations.Application.Services.INotificationService NotificationSvc
@{
    var page      = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isAccom  = page.StartsWith("/Accommodations") || page == "/Index" || page == "/";
    bool isDash   = page.StartsWith("/Dashboard");
    bool isAuth   = page.StartsWith("/Auth");
    bool loggedIn = User.Identity?.IsAuthenticated == true;
    string userName = loggedIn ? (User.Identity!.Name ?? "") : "";
    string userInitials = userName.Length > 0
        ? string.Concat(userName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(n => char.ToUpper(n[0])))
        : "U";
    string pageTitle = ViewData["Title"]?.ToString() ?? "Reservas";

    int unreadCount = 0;
    if (loggedIn)
    {
        var rawId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(rawId, out var layoutUserId))
            unreadCount = await NotificationSvc.GetUnreadCountAsync(layoutUserId);
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle — Sistema de Reservas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (loggedIn)
{
    <!-- ════════════════════════════════════════════════════════
         LAYOUT AUTENTICADO: Sidebar + Main
         ════════════════════════════════════════════════════════ -->
    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div>
                    <div class="brand-name">Sistema de Reservas</div>
                    <div class="brand-sub">Sedes y Apartamentos</div>
                </div>
            </div>

            <div class="nav-section">Reservar</div>

            <a asp-page="/Accommodations/Index" class="nav-item @(isAccom ? "active" : "")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Sedes y Apartamentos
            </a>

            <a asp-page="/Dashboard/Index" class="nav-item @(isDash ? "active" : "")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="3" y1="9" x2="21" y2="9"/>
                    <line x1="9" y1="4" x2="9" y2="9"/>
                    <line x1="15" y1="4" x2="15" y2="9"/>
                </svg>
                Mis Reservas
            </a>

            <div class="nav-section">Cuenta</div>

            <a asp-page="/Profile/Index" class="nav-item @(page.StartsWith("/Profile/Index") || page == "/Profile" ? "active" : "")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                </svg>
                Mi perfil
            </a>


<a asp-page="/Profile/Notifications" class="nav-item @(page.StartsWith("/Profile/Notif") ? "active" : "")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                Notificaciones
                @if (unreadCount > 0)
                {
                    <span class="nav-badge">@unreadCount</span>
                }
            </a>

            <div class="sidebar-spacer"></div>

            <div class="sidebar-support">
                <div class="eyebrow">Soporte</div>
                <p>¿Necesitas ayuda con tu reserva?</p>
                <button class="sidebar-support-btn" type="button">Contactar asesor</button>
            </div>

            <a asp-page="/Auth/Logout" class="nav-item nav-item-logout">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Cerrar Sesión
            </a>
        </aside>

        <!-- MAIN -->
        <main class="main">
            <div class="topbar">
                <div class="topbar-breadcrumb">
                    <span>Inicio</span>
                    <span class="crumb-sep">/</span>
                    <span class="crumb-curr">@pageTitle</span>
                </div>
                <div class="user-chip">
                    <span class="user-name">@(userName.Split(' ').FirstOrDefault() ?? "Usuario")</span>
                    <div class="user-avatar">@userInitials</div>
                </div>
            </div>

            @if (TempData["SuccessMessage"] is string ok)
            {
                <div style="padding:0 32px 0">
                    <div class="fodun-alert fodun-alert-success">@ok</div>
                </div>
            }
            @if (TempData["ErrorMessage"] is string err)
            {
                <div style="padding:0 32px 0">
                    <div class="fodun-alert fodun-alert-error">@err</div>
                </div>
            }

            <div class="content fade-in">
                @RenderBody()
            </div>

            <footer class="main-footer">
                Sistema de Reservas · Derechos Reservados &copy; @DateTime.Now.Year
            </footer>
        </main>

        <!-- Bottom nav (solo mobile) -->
        <nav class="mobile-nav">
            <a asp-page="/Accommodations/Index" class="mobile-nav-item @(isAccom ? "active" : "")">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span>Destinos</span>
            </a>
            <a asp-page="/Dashboard/Index" class="mobile-nav-item @(isDash ? "active" : "")">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="3" y1="9" x2="21" y2="9"/>
                    <line x1="9" y1="4" x2="9" y2="9"/>
                    <line x1="15" y1="4" x2="15" y2="9"/>
                </svg>
                <span>Reservas</span>
            </a>
            <a asp-page="/Auth/Logout" class="mobile-nav-item">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>Salir</span>
            </a>
        </nav>

    </div>
}
else
{
    <!-- ════════════════════════════════════════════════════════
         LAYOUT PÚBLICO: Header + Nav + Contenido centrado
         ════════════════════════════════════════════════════════ -->
    <div class="public-shell">

        <!-- HEADER PÚBLICO -->
        <header class="public-header">
            <div class="public-header-inner">
                <!-- Marca -->
                <a asp-page="/Accommodations/Index" class="public-brand">
                    <div>
                        <div style="font-weight:800;font-size:14px;color:var(--ink);letter-spacing:.01em;line-height:1.2">Sistema de Reservas</div>
                        <div style="font-family:var(--font-mono);font-size:9.5px;color:var(--ink-4);letter-spacing:.07em;text-transform:uppercase">Sedes y Apartamentos</div>
                    </div>
                </a>

                <!-- Nav links -->
                <nav class="public-nav">
                    <a asp-page="/Accommodations/Index"
                       class="public-nav-link @(isAccom ? "active" : "")">
                        Sedes y Apartamentos
                    </a>
                    <a asp-page="/Auth/Login"
                       class="public-nav-link @(isAuth ? "active" : "")">
                        Iniciar sesión
                    </a>
                    <a asp-page="/Auth/Register" class="btn btn-sm">
                        Crear cuenta
                    </a>
                </nav>
            </div>
        </header>

        <!-- Alertas globales -->
        @if (TempData["SuccessMessage"] is string ok2)
        {
            <div class="public-alert-wrap">
                <div class="fodun-alert fodun-alert-success">@ok2</div>
            </div>
        }
        @if (TempData["ErrorMessage"] is string err2)
        {
            <div class="public-alert-wrap">
                <div class="fodun-alert fodun-alert-error">@err2</div>
            </div>
        }

        <!-- Contenido -->
        <main class="public-content fade-in">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="public-footer">
            Sistema de Reservas · Derechos Reservados &copy; @DateTime.Now.Year
        </footer>

    </div>
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
