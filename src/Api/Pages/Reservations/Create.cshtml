@page
@model FODUN.Reservations.Api.Pages.Reservations.CreateModel
@using System.Globalization
@{
    ViewData["Title"] = "Confirmar Reserva";
    var cop = new CultureInfo("es-CO");
}

<!-- Encabezado -->
<div style="display:flex;align-items:center;gap:14px;margin-bottom:24px">
    <a href="javascript:history.back()" class="btn btn-ghost btn-sm" style="padding-left:0">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 12H5M11 18l-6-6 6-6"/>
        </svg>
        Volver
    </a>
    <div>
        <div class="eyebrow" style="margin-bottom:4px">Nueva reserva</div>
        <h2 class="h-1" style="margin:0">Confirmar Reserva</h2>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="fodun-alert fodun-alert-error">@Model.ErrorMessage</div>
}

@if (Model.CostEstimate is not null && Model.RoomInfo is not null)
{
    <div class="create-layout">

        <!-- Columna izquierda: detalles -->
        <div>
            <!-- Detalle del alojamiento -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:middle">
                        <path d="M3 18V8m0 10h18V13a3 3 0 0 0-3-3H10v3"/><path d="M3 13h18"/><circle cx="6.5" cy="13" r="1.5"/>
                    </svg>
                    Detalle del alojamiento
                </div>
                <div class="detail-card-body">
                    <div class="detail-row">
                        <dt>Alojamiento</dt>
                        <dd>@Model.RoomInfo.Type — @Model.RoomInfo.SeatNumber</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Capacidad</dt>
                        <dd>@Model.RoomInfo.Capacity persona(s)</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Fecha de llegada</dt>
                        <dd>@Model.CheckIn.ToString("dd 'de' MMMM 'de' yyyy", new CultureInfo("es-CO"))</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Fecha de salida</dt>
                        <dd>@Model.CheckOut.ToString("dd 'de' MMMM 'de' yyyy", new CultureInfo("es-CO"))</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Noches</dt>
                        <dd>@Model.CostEstimate.Nights</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Personas</dt>
                        <dd>@Model.Persons</dd>
                    </div>
                    @if (Model.CostEstimate.AdditionalPersons > 0)
                    {
                        <div class="detail-row">
                            <dt>Personas adicionales</dt>
                            <dd><span class="pill pill-warn">@Model.CostEstimate.AdditionalPersons adicionales</span></dd>
                        </div>
                    }
                    <div class="detail-row">
                        <dt>Temporada</dt>
                        <dd>
                            <span class="pill @(Model.RoomInfo.Season.Contains("Alta") ? "pill-warn" : "pill-good")">
                                @Model.RoomInfo.Season
                            </span>
                        </dd>
                    </div>
                    <div class="detail-row">
                        <dt>Tarifa por noche</dt>
                        <dd><strong>@Model.RoomInfo.PricePerNight.ToString("C0", cop)</strong></dd>
                    </div>
                </div>
            </div>

            <!-- Resumen de costos -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:middle">
                        <rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h3"/>
                    </svg>
                    Resumen de costos
                </div>
                <div class="detail-card-body">
                    <div class="summary-row">
                        <span class="label">Costo base (@Model.CostEstimate.Nights noches)</span>
                        <span>@Model.CostEstimate.BaseTotal.ToString("C0", cop)</span>
                    </div>
                    @if (Model.CostEstimate.AdditionalPersonsTotal > 0)
                    {
                        <div class="summary-row">
                            <span class="label">Personas adicionales</span>
                            <span>@Model.CostEstimate.AdditionalPersonsTotal.ToString("C0", cop)</span>
                        </div>
                    }
                    <div class="summary-row">
                        <span class="label">Servicio de lavandería</span>
                        <span id="laundry-cost">@(Model.IncludeLaundry ? "$18.000" : "$0")</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total estimado</span>
                        <span class="price-highlight" id="total-cost">
                            @Model.CostEstimate.GrandTotal.ToString("C0", cop)
                        </span>
                    </div>
                </div>
            </div>

            <!-- Formulario de confirmación -->
            <div class="detail-card">
                <div class="detail-card-header">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="margin-right:6px;vertical-align:middle">
                        <path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-5"/><path d="M14.5 3.5l6 6"/><path d="m17 2 5 5-9.5 9.5L8 18l1.5-4.5L17 2z"/>
                    </svg>
                    Opciones y observaciones
                </div>
                <div class="detail-card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Input.AccommodationId" />
                        <input type="hidden" asp-for="Input.SeatId" />
                        <input type="hidden" asp-for="Input.CheckIn" />
                        <input type="hidden" asp-for="Input.CheckOut" />
                        <input type="hidden" asp-for="Input.TotalPersons" />

                        <!-- Lavandería -->
                        <div style="display:flex;align-items:flex-start;gap:12px;padding:14px;background:var(--bg-elev);border-radius:var(--radius-md);border:1px solid var(--line);margin-bottom:16px">
                            <input type="checkbox" asp-for="Input.IncludeLaundry" id="laundry"
                                   style="width:16px;height:16px;margin-top:2px;accent-color:var(--accent);flex-shrink:0" />
                            <label for="laundry" style="cursor:pointer">
                                <div style="font-weight:600;font-size:13px">Servicio de lavandería</div>
                                <div style="font-size:12px;color:var(--ink-3);margin-top:2px">
                                    Costo fijo adicional de <strong>$18.000</strong> por estancia.
                                </div>
                            </label>
                        </div>

                        <!-- Observaciones -->
                        <div class="field">
                            <label>Observaciones (opcional)</label>
                            <textarea asp-for="Input.Notes" rows="3"
                                      placeholder="Alergias, necesidades especiales, hora estimada de llegada…"
                                      style="resize:vertical"></textarea>
                        </div>

                        <button type="submit" class="btn btn-block btn-lg" style="margin-top:8px">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="m5 12 4.5 4.5L19 7"/>
                            </svg>
                            Confirmar reserva
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna derecha: resumen sticky -->
        <div class="create-summary-sticky">
            <div class="summary-card">
                <div class="summary-card-title">Tu Reserva</div>

                <!-- Thumbnail de la sede -->
                <div style="height:110px;border-radius:var(--radius-md);overflow:hidden;margin-bottom:14px;background:linear-gradient(135deg,var(--accent-dark),var(--accent));display:flex;align-items:center;justify-content:center">
                    <div style="color:rgba(255,255,255,.7);font-family:var(--font-mono);font-size:11px;text-align:center;letter-spacing:.1em">
                        <div style="font-size:18px;font-weight:900;color:white;letter-spacing:.05em">RESERVA</div>
                        CONFIRMACIÓN
                    </div>
                </div>

                <div style="font-weight:700;font-size:14px;margin-bottom:2px">@Model.RoomInfo.Type</div>
                <div style="font-size:12px;color:var(--ink-3);margin-bottom:14px">@Model.RoomInfo.SeatNumber</div>

                <div class="divider"></div>

                <div class="summary-row">
                    <span class="label">Check-in</span>
                    <span>@Model.CheckIn.ToString("dd MMM yyyy", new CultureInfo("es-CO"))</span>
                </div>
                <div class="summary-row">
                    <span class="label">Check-out</span>
                    <span>@Model.CheckOut.ToString("dd MMM yyyy", new CultureInfo("es-CO"))</span>
                </div>
                <div class="summary-row">
                    <span class="label">Noches</span>
                    <span>@Model.CostEstimate.Nights</span>
                </div>
                <div class="summary-row">
                    <span class="label">Personas</span>
                    <span>@Model.Persons</span>
                </div>

                <div class="summary-card-title" style="margin-top:16px;margin-bottom:8px">Total estimado</div>
                <div class="summary-grand" id="summary-grand">
                    @Model.CostEstimate.GrandTotal.ToString("C0", cop)
                </div>

                <div style="font-size:11px;color:var(--ink-4);line-height:1.4">
                    El total puede variar según las opciones seleccionadas. El valor final se confirma al completar la reserva.
                </div>
            </div>
        </div>

    </div>
}
else if (string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="fodun-alert fodun-alert-error" style="margin-top:8px">
        Parámetros de reserva incompletos.
        <a asp-page="/Accommodations/Index" style="font-weight:700;color:var(--accent-2)">
            Seleccionar sede →
        </a>
    </div>
}

@section Scripts {
<script>
(function() {
    const laundry = document.getElementById('laundry');
    if (!laundry) return;
    const grandTotal = @Model.CostEstimate?.GrandTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const laundryAmt  = 18000;
    const fmt = (n) => '$ ' + Math.round(n).toLocaleString('es-CO');

    laundry.addEventListener('change', function() {
        const extra = this.checked ? laundryAmt : 0;
        const total = grandTotal + extra;
        document.getElementById('laundry-cost').textContent = this.checked ? '$18.000' : '$0';
        document.getElementById('total-cost').textContent = fmt(total);
        const sg = document.getElementById('summary-grand');
        if (sg) sg.textContent = fmt(total);
    });
})();
</script>
}
