@page
@model FODUN.Reservations.Api.Pages.Profile.NotificationsModel
@{
    ViewData["Title"] = "Notificaciones";
    var notifications = Model.Notifications.ToList();
}

<style>
.notif-page { max-width: 720px; margin: 0 auto; padding: 32px 24px; }
.notif-header { margin-bottom: 28px; }
.notif-header h1 { font-size: 22px; font-weight: 700; color: var(--ink); margin: 0 0 4px; }
.notif-header p { font-size: 13.5px; color: var(--ink-4); margin: 0; }

.notif-empty {
    text-align: center;
    padding: 64px 24px;
    color: var(--ink-4);
}
.notif-empty svg { opacity: .35; margin-bottom: 14px; }
.notif-empty p { font-size: 14px; margin: 0; }

.notif-list { display: flex; flex-direction: column; gap: 10px; }

.notif-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    transition: box-shadow .15s;
}
.notif-card:hover { box-shadow: 0 2px 10px rgba(0,0,0,.06); }
.notif-card.unread { background: var(--accent-soft); border-color: #e8c8c8; }

.notif-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
.notif-icon.created  { background: #e8f4ec; color: var(--good); }
.notif-icon.payment  { background: #e8f0fc; color: #1a5bc7; }
.notif-icon.cancelled { background: #fdf0f0; color: var(--accent); }
.notif-icon.default  { background: var(--surface); color: var(--ink-4); }

.notif-body { flex: 1; min-width: 0; }
.notif-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 3px;
}
.notif-msg {
    font-size: 13px;
    color: var(--ink-3);
    margin: 0 0 6px;
    line-height: 1.5;
}
.notif-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    color: var(--ink-4);
}
.notif-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
}

.notif-link {
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
}
.notif-link:hover { text-decoration: underline; }
</style>

<div class="notif-page">
    <div class="notif-header">
        <h1>Notificaciones</h1>
        <p>Aquí aparecen los eventos de tus reservas y procesos.</p>
    </div>

    @if (!notifications.Any())
    {
        <div class="notif-empty">
            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <p>No tienes notificaciones todavía.</p>
        </div>
    }
    else
    {
        <div class="notif-list">
            @foreach (var n in notifications)
            {
                string iconClass = n.Type switch
                {
                    "reservation_created" => "created",
                    "payment_submitted"   => "payment",
                    "reservation_cancelled" => "cancelled",
                    _ => "default"
                };

                <div class="notif-card @(n.IsRead ? "" : "unread")">
                    <div class="notif-icon @iconClass">
                        @if (n.Type == "reservation_created")
                        {
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        }
                        else if (n.Type == "payment_submitted")
                        {
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                <rect x="2" y="5" width="20" height="14" rx="2"/>
                                <line x1="2" y1="10" x2="22" y2="10"/>
                            </svg>
                        }
                        else if (n.Type == "reservation_cancelled")
                        {
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                        }
                    </div>
                    <div class="notif-body">
                        <p class="notif-title">@n.Title</p>
                        <p class="notif-msg">@n.Message</p>
                        <div class="notif-meta">
                            @if (!n.IsRead)
                            {
                                <span class="notif-dot" title="Sin leer"></span>
                            }
                            <span>@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            @if (n.ReservationId.HasValue)
                            {
                                <a class="notif-link" asp-page="/Reservations/Detail" asp-route-id="@n.ReservationId">Ver reserva</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
