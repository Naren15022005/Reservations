@page
@model FODUN.Reservations.Api.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="form-card">
            <h2 class="section-title">Nueva contraseña</h2>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            @if (Model.IsTokenValid)
            {
                <form method="post">
                    <input type="hidden" asp-for="Token" />
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label">Nueva contraseña</label>
                        <input asp-for="Input.NewPassword" class="form-control" type="password"
                               placeholder="Mínimo 8 caracteres, una mayúscula y un número" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Restablecer contraseña</button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    El enlace de restablecimiento no es válido o ha expirado.
                    <a asp-page="/Auth/ForgotPassword">Solicitar un nuevo enlace</a>.
                </div>
            }

            <hr />
            <div class="text-center">
                <a asp-page="/Auth/Login">Volver al inicio de sesión</a>
            </div>
        </div>
    </div>
</div>
