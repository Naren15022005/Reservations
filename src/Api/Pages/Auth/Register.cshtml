@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="reg-page">

    <div class="reg-card fade-in">

        <!-- Marca -->
        <div class="reg-brand">
            <div class="reg-brand-logo">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <div>
                <div class="reg-brand-name">Sistema de Reservas</div>
                <div class="reg-brand-sub">Sedes y Apartamentos</div>
            </div>
        </div>

        <!-- Encabezado -->
        <div class="reg-header">
            <h1 class="reg-title">Crea tu cuenta</h1>
            <p class="reg-subtitle">Regístrate para reservar sedes y apartamentos.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="fodun-alert fodun-alert-error" style="margin-bottom:20px">@Model.ErrorMessage</div>
        }

        <!-- Google -->
        <a href="/Auth/GoogleSignIn@(!string.IsNullOrEmpty(Model.ReturnUrl) ? "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl) : "")" class="btn-google">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Continuar con Google
        </a>

        <div class="reg-divider">
            <span>o continúa con tu correo</span>
        </div>

        <!-- Formulario -->
        <form method="post" class="reg-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="reg-field-wrap">
                <label class="reg-label" for="Input_FullName">Nombre completo</label>
                <div class="reg-input-box">
                    <svg class="reg-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                    </svg>
                    <input asp-for="Input.FullName" type="text" autocomplete="name"
                           placeholder="Tu nombre completo" class="reg-input" maxlength="255" />
                </div>
                <span asp-validation-for="Input.FullName" class="reg-val-error"></span>
            </div>

            <div class="reg-field-wrap">
                <label class="reg-label" for="Input_DocumentNumber">Número de documento</label>
                <div class="reg-input-box">
                    <svg class="reg-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="16" rx="2"/><line x1="7" y1="9" x2="17" y2="9"/><line x1="7" y1="13" x2="13" y2="13"/>
                    </svg>
                    <input asp-for="Input.DocumentNumber" type="text" autocomplete="off"
                           placeholder="Ej: 1234567890" class="reg-input" maxlength="20" />
                </div>
                <span asp-validation-for="Input.DocumentNumber" class="reg-val-error"></span>
            </div>

            <div class="reg-field-wrap">
                <label class="reg-label" for="Input_Email">Correo electrónico</label>
                <div class="reg-input-box">
                    <svg class="reg-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="14" rx="2"/>
                        <path d="m3 7 9 7 9-7"/>
                    </svg>
                    <input asp-for="Input.Email" type="email" autocomplete="email"
                           placeholder="correo@ejemplo.com" class="reg-input" />
                </div>
                <span asp-validation-for="Input.Email" class="reg-val-error"></span>
            </div>

            <div class="reg-field-wrap">
                <label class="reg-label" for="Input_Password">Contraseña</label>
                <div class="reg-input-box">
                    <svg class="reg-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <input id="reg-pwd" asp-for="Input.Password" type="password"
                           autocomplete="new-password" placeholder="Mínimo 8 caracteres"
                           class="reg-input reg-input-padded" />
                    <button type="button" class="reg-eye-btn" tabindex="-1"
                            onclick="togglePwd('reg-pwd',this)" aria-label="Mostrar contraseña">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="reg-val-error"></span>
                <p class="reg-hint">Mínimo 8 caracteres, una mayúscula y un número.</p>
            </div>

            <div class="reg-field-wrap">
                <label class="reg-label" for="Input_ConfirmPassword">Confirmar contraseña</label>
                <div class="reg-input-box">
                    <svg class="reg-input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <input id="reg-pwd2" asp-for="Input.ConfirmPassword" type="password"
                           autocomplete="new-password" placeholder="Repite tu contraseña"
                           class="reg-input reg-input-padded" />
                    <button type="button" class="reg-eye-btn" tabindex="-1"
                            onclick="togglePwd('reg-pwd2',this)" aria-label="Mostrar contraseña">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="reg-val-error"></span>
            </div>

            <button type="submit" class="reg-submit-btn">
                Crear cuenta
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
            </button>

        </form>

        <p class="reg-login-link">
            ¿Ya tienes cuenta?
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Iniciar sesión →</a>
        </p>

    </div>

</div>

@section Scripts {
<script>
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const show  = input.type === 'password';
    input.type  = show ? 'text' : 'password';
    btn.style.color = show ? 'var(--accent)' : 'var(--ink-4)';
}
</script>
}
