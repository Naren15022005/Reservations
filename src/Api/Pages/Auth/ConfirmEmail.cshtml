@page
@model FODUN.Reservations.Api.Pages.Auth.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmar correo electrónico";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">
        @if (Model.Success)
        {
            <div class="form-card">
                <div class="mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor"
                         class="text-success" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                </div>
                <h2 class="text-success mb-2">¡Correo confirmado!</h2>
                <p class="text-muted mb-4">Tu cuenta ha sido verificada exitosamente. Ya puedes acceder al Sistema de Reservas.</p>
                <a asp-page="/Auth/Login" class="btn btn-primary">Iniciar sesión</a>
            </div>
        }
        else
        {
            <div class="form-card">
                <div class="mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor"
                         class="text-danger" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                    </svg>
                </div>
                <h2 class="text-danger mb-2">Enlace inválido</h2>
                <p class="text-muted mb-4">@Model.ErrorMessage</p>
                <a asp-page="/Auth/Login" class="btn btn-outline-primary">Volver al inicio de sesión</a>
            </div>
        }
    </div>
</div>
