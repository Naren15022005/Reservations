@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="text-center mb-4">Recuperar Contraseña</h2>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="text-muted">Ingresa tu correo y te enviaremos un enlace para restablecer tu contraseña.</p>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Enviar enlace</button>
                </form>
                <div class="text-center mt-3">
                    <a asp-page="./Login">Volver al login</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
